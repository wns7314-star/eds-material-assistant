name: EDS native Windows verification
on:
  push:
    branches: [native-windows-qa-20261117]
    paths: ['.github/workflows/eds-native-windows.yml', 'native-qa/start.txt']
permissions:
  contents: read
jobs:
  windows-exe:
    runs-on: windows-2022
    timeout-minutes: 40
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
      - uses: actions/setup-node@v4
        with:
          node-version: '22'
      - name: Install isolated test dependencies
        shell: pwsh
        run: |
          python -m pip install --disable-pip-version-check cryptography
          npm install --prefix "$env:RUNNER_TEMP/eds-test-deps" playwright
      - name: Create one-use encryption key
        run: python native-qa/bootstrap.py keygen
      - name: Publish public encryption key
        uses: actions/upload-artifact@v4
        with:
          name: eds-native-public-key
          path: native-handshake/public.pem
          retention-days: 1
      - name: Run private package on native Windows
        run: python native-qa/bootstrap.py
      - name: Retain encrypted verification evidence
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: eds-native-windows-evidence
          path: native-output/
          retention-days: 7
          if-no-files-found: warn
